{
  "manifest_version": 3,
  "name": "TorrentLinker companion",
  "version": "0.2.0",
  "key": "",
  "description": "Automatically update your connected TorrentLinker profile from your c411 browser session.",
  "permissions": ["scripting", "storage", "alarms"],
  "host_permissions": [
    "https://c411.org/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "externally_connectable": {
    "matches": ["http://127.0.0.1/*", "http://localhost/*"]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TorrentLinker connection and sync status"
  }
}
